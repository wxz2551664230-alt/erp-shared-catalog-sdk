{
  "openapi": "3.1.0",
  "info": {
    "title": "Public Shared Catalog API",
    "version": "1.1.0",
    "description": "Public read and create. No account, password, API key or cookie required. Update/delete and other ERP APIs are not public."
  },
  "servers": [
    {
      "url": "https://erp.example.com",
      "description": "Replace with the service root provided by the administrator"
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/shared-catalog/v1/capabilities": {
      "get": {
        "tags": [
          "shared-catalog"
        ],
        "summary": "Capabilities",
        "operationId": "capabilities_api_v1_shared_catalog_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/shared-catalog/v1/products": {
      "get": {
        "tags": [
          "shared-catalog"
        ],
        "summary": "Products",
        "operationId": "products_api_v1_shared_catalog_v1_products_get",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": "",
              "title": "Search"
            }
          },
          {
            "name": "after_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 32,
              "default": "",
              "title": "After Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      },
      "post": {
        "tags": [
          "shared-catalog"
        ],
        "summary": "Import Product",
        "operationId": "import_product_api_v1_shared_catalog_v1_products_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SharedImport"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/shared-catalog/v1/products/{product_id}": {
      "get": {
        "tags": [
          "shared-catalog"
        ],
        "summary": "Product",
        "operationId": "product_api_v1_shared_catalog_v1_products__product_id__get",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SharedImport": {
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,59}$",
            "title": "Source"
          },
          "external_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "External Id"
          },
          "sku": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Name"
          },
          "source_url": {
            "type": "string",
            "maxLength": 4000,
            "title": "Source Url",
            "default": ""
          },
          "supplier": {
            "type": "string",
            "maxLength": 120,
            "title": "Supplier",
            "default": ""
          },
          "description_category_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Description Category Id"
          },
          "type_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Type Id"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/SharedVariant"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Variants"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "external_id",
          "sku",
          "name",
          "variants"
        ],
        "title": "SharedImport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "SharedVariant": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Sku"
          },
          "specification": {
            "type": "string",
            "maxLength": 500,
            "title": "Specification",
            "default": ""
          },
          "color": {
            "type": "string",
            "maxLength": 200,
            "title": "Color",
            "default": ""
          },
          "size": {
            "type": "string",
            "maxLength": 200,
            "title": "Size",
            "default": ""
          },
          "purchase_price_cny": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchase Price Cny"
          },
          "package_length_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Length Mm"
          },
          "package_width_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Width Mm"
          },
          "package_height_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Package Height Mm"
          },
          "weight_grams": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Grams"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 15,
            "title": "Images"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku"
        ],
        "title": "SharedVariant"
      }
    }
  }
}
